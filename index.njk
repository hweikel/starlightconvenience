---
layout: base.njk
permalink: /index.html
eleventyExcludeFromCollections: true
eleventyComputed:
  activeId: "{{ collections.entries[0].id }}"
---
{%- set entry = collections.entries[0] %}
<article class="post{% if entry.project %} post-project{% endif %}">
  <h1 class="post-title">
    {%- if entry.project.mark %}<span class="title-mark" style="--mark: url('{{ entry.project.mark | url }}')"{% if entry.project.markAlt %} role="img" aria-label="{{ entry.project.markAlt }}"{% endif %}></span>{% endif -%}
    <span class="title-text">{{ entry.title }}</span>
  </h1>
  <div class="post-date">{{ entry.label }}</div>
  {%- if entry.project %}
  <a class="project" href="{{ entry.project.href }}" target="_blank" rel="noopener">
    <img class="project-img" src="{{ entry.project.img | url }}" alt="{{ entry.project.alt }}">
  </a>
  {%- else %}
  <div class="post-body">{{ entry.note.templateContent | safe }}</div>
  {%- endif %}
</article>
