{%- set active = activeId or page.fileSlug -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}Starlight Convenience</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90' fill='%232f73f7'>✴</text></svg>">
  <link rel="alternate" type="application/atom+xml" title="Starlight Convenience" href="{{ '/feed.xml' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
</head>
<body>
  <div class="page">
    <nav class="column">
      <a class="shard" href="{{ '/' | url }}">
        <img src="{{ '/assets/images/star-fragment.png' | url }}" alt="">
      </a>

      <a class="row row-head" href="{{ '/' | url }}">
        <span class="row-title">Starlight Convenience</span>
      </a>

      {%- for entry in collections.entries %}
      {%- if entry.project %}
      <a class="row row-image{% if entry.id == active %} active{% endif %}" href="{{ entry.url | url }}">
        <img class="row-img" src="{{ entry.project.img | url }}" alt="{{ entry.project.alt }}">
      </a>
      {%- else %}
      <a class="row{% if entry.id == active %} active{% endif %}" href="{{ entry.url | url }}">
        <span class="row-title">{{ entry.title }}</span>
      </a>
      {%- endif %}
      {%- endfor %}

      <div class="row row-links">
        <a href="{{ '/feed.xml' | url }}">RSS</a>
        <a href="https://www.henryweikel.net/" target="_blank" rel="noopener">henryweikel.net</a>
      </div>
    </nav>

    <main class="reader">
      {{ content | safe }}

      {%- for entry in collections.entries %}
      {%- if entry.id == active %}
      <div class="post-nav">
        {%- if entry.olderUrl %}<a class="post-nav-prev" href="{{ entry.olderUrl | url }}">⇜︎</a>{% endif %}
        {%- if entry.newerUrl %}<a class="post-nav-next" href="{{ entry.newerUrl | url }}">⇝︎</a>{% endif %}
      </div>
      {%- endif %}
      {%- endfor %}
    </main>
  </div>
</body>
</html>
